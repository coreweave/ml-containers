From 9a107e6275cda08dd5a860a4cf2740f8170452a1 Mon Sep 17 00:00:00 2001
From: Aleksandr Malyshev <amalyshev@coreweave.com>
Date: Thu, 27 Aug 2026 11:33:09 -0700
Subject: [PATCH] feat: add SiTU (Kimi K3) activation to CuTe-DSL MoE GEMM1

Add direct ActivationType.Situ support to the gather grouped GEMM
activation-fusion epilogue. The direct API uses swiglu_alpha and
swiglu_beta as the gate and linear tanh scales, matching vLLM's
gemm1_alpha/gemm1_beta contract.

Keep the pinned release's existing parameterized SiTU API
(ActivationType.Swiglu with situ_beta/situ_linear_beta) unchanged.

AI-assisted.

Co-authored-by: Cursor <cursoragent@cursor.com>
---

diff --git a/flashinfer/fused_moe/cute_dsl/blackwell/blockscaled_contiguous_gather_grouped_gemm_act_fusion.py b/flashinfer/fused_moe/cute_dsl/blackwell/blockscaled_contiguous_gather_grouped_gemm_act_fusion.py
index 1614e5f166d05b34bfcebc9db1912a3b084aebbd..2d917b0e1e98618f478ac23b45e436985737aab5 100644
--- a/flashinfer/fused_moe/cute_dsl/blackwell/blockscaled_contiguous_gather_grouped_gemm_act_fusion.py
+++ b/flashinfer/fused_moe/cute_dsl/blackwell/blockscaled_contiguous_gather_grouped_gemm_act_fusion.py
@@ -469,9 +469,11 @@ class BlockScaledContiguousGatherGroupedGemmKernel:
         :param enable_pdl: Enable Programmatic Dependent Launch.
         :type enable_pdl: bool
         :param activation_type: FC1 activation type. Use ActivationType.Swiglu
-            for gated SwiGLU/OAI/SiTU, ActivationType.GegluTanh for
-            tanh-approximate GeGLU, and ActivationType.Relu2 for non-gated
-            ReLU^2. Setting situ_beta selects SiTU.
+            for gated SwiGLU/OAI or parameterized SiTU, ActivationType.Situ for
+            direct SiTU with swiglu_alpha/beta as its tanh scales,
+            ActivationType.GegluTanh for tanh-approximate GeGLU, and
+            ActivationType.Relu2 for non-gated ReLU^2. Setting situ_beta
+            selects SiTU.
         :type activation_type: int
         :param swiglu_alpha: Sigmoid multiplier for parameterized SwiGLU.
         :type swiglu_alpha: float
@@ -581,6 +583,15 @@ class BlockScaledContiguousGatherGroupedGemmKernel:
                 f"gated={gated} is inconsistent with activation_type {activation_type!r}"
             )
         validate_cute_dsl_moe_situ_config(activation_type, situ_beta, situ_linear_beta)
+        if activation_type == ActivationType.Situ and (
+            swiglu_alpha == 0.0 or swiglu_beta == 0.0
+        ):
+            raise ValueError(
+                "Situ requires non-zero swiglu_alpha (gate tanh scale) and "
+                "swiglu_beta (linear tanh scale); pass swiglu_beta=1.0 for the "
+                "standard SiTU formulation (the SwiGLU default beta=0.0 is "
+                "invalid for Situ)."
+            )
         self.vectorized_f32 = vectorized_f32
         self.activation_type = int(activation_type)
         self.swiglu_alpha = swiglu_alpha
@@ -2802,7 +2813,138 @@ class BlockScaledContiguousGatherGroupedGemmKernel:
                         swiglu_beta = cutlass.Float32(self.swiglu_beta)
                         swiglu_limit = cutlass.Float32(self.swiglu_limit)
                         LOG2_E = cutlass.Float32(1.4426950408889634)
-                        if cutlass.const_expr(self.situ_beta is not None):
+                        if cutlass.const_expr(
+                            self.activation_type == ActivationType.Situ.value
+                        ):
+                            inv_alpha = cutlass.Float32(
+                                f32_reciprocal(self.swiglu_alpha)
+                            )
+                            inv_beta = cutlass.Float32(
+                                f32_reciprocal(self.swiglu_beta)
+                            )
+                            if cutlass.const_expr(self.vectorized_f32):
+                                for i in cutlass.range_constexpr(
+                                    0, cute.size(tTR_rAcc_up), 2
+                                ):
+                                    up_dequant = cute.arch.mul_packed_f32x2(
+                                        (acc_vec_up[i], acc_vec_up[i + 1]),
+                                        (
+                                            cutlass.Float32(alpha_val),
+                                            cutlass.Float32(alpha_val),
+                                        ),
+                                    )
+                                    gate_dequant = cute.arch.mul_packed_f32x2(
+                                        (acc_vec_gate[i], acc_vec_gate[i + 1]),
+                                        (
+                                            cutlass.Float32(alpha_val),
+                                            cutlass.Float32(alpha_val),
+                                        ),
+                                    )
+                                    gate_clamped = (
+                                        fmin(gate_dequant[0], swiglu_limit, nan=True),
+                                        fmin(gate_dequant[1], swiglu_limit, nan=True),
+                                    )
+                                    up_clamped = (
+                                        -fmin(
+                                            -fmin(
+                                                up_dequant[0], swiglu_limit, nan=True
+                                            ),
+                                            swiglu_limit,
+                                            nan=True,
+                                        ),
+                                        -fmin(
+                                            -fmin(
+                                                up_dequant[1], swiglu_limit, nan=True
+                                            ),
+                                            swiglu_limit,
+                                            nan=True,
+                                        ),
+                                    )
+                                    left = cute.arch.mul_packed_f32x2(
+                                        (
+                                            cute.math.tanh(
+                                                up_clamped[0] * inv_beta,
+                                                fastmath=True,
+                                            ),
+                                            cute.math.tanh(
+                                                up_clamped[1] * inv_beta,
+                                                fastmath=True,
+                                            ),
+                                        ),
+                                        (swiglu_beta, swiglu_beta),
+                                    )
+                                    gate_scaled = cute.arch.mul_packed_f32x2(
+                                        gate_clamped, (inv_alpha, inv_alpha)
+                                    )
+                                    right = cute.arch.mul_packed_f32x2(
+                                        cute.arch.mul_packed_f32x2(
+                                            (
+                                                cute.math.tanh(
+                                                    gate_scaled[0], fastmath=True
+                                                ),
+                                                cute.math.tanh(
+                                                    gate_scaled[1], fastmath=True
+                                                ),
+                                            ),
+                                            (swiglu_alpha, swiglu_alpha),
+                                        ),
+                                        (
+                                            cute.arch.rcp_approx(
+                                                1.0
+                                                + cute.math.exp2(
+                                                    -(LOG2_E * gate_clamped[0]),
+                                                    fastmath=True,
+                                                )
+                                            ),
+                                            cute.arch.rcp_approx(
+                                                1.0
+                                                + cute.math.exp2(
+                                                    -(LOG2_E * gate_clamped[1]),
+                                                    fastmath=True,
+                                                )
+                                            ),
+                                        ),
+                                    )
+                                    (
+                                        tCompute[i],
+                                        tCompute[i + 1],
+                                    ) = cute.arch.mul_packed_f32x2(left, right)
+                            else:
+                                for i in cutlass.range_constexpr(
+                                    cute.size(tTR_rAcc_up)
+                                ):
+                                    up_dequant = acc_vec_up[i] * cutlass.Float32(
+                                        alpha_val
+                                    )
+                                    gate_dequant = acc_vec_gate[i] * cutlass.Float32(
+                                        alpha_val
+                                    )
+                                    gate_clamped = fmin(
+                                        gate_dequant, swiglu_limit, nan=True
+                                    )
+                                    up_clamped = -fmin(
+                                        -fmin(up_dequant, swiglu_limit, nan=True),
+                                        swiglu_limit,
+                                        nan=True,
+                                    )
+                                    left = swiglu_beta * cute.math.tanh(
+                                        up_clamped * inv_beta, fastmath=True
+                                    )
+                                    sigmoid_gate = cute.arch.rcp_approx(
+                                        1.0
+                                        + cute.math.exp2(
+                                            -(LOG2_E * gate_clamped), fastmath=True
+                                        )
+                                    )
+                                    right = (
+                                        swiglu_alpha
+                                        * cute.math.tanh(
+                                            gate_clamped * inv_alpha, fastmath=True
+                                        )
+                                        * sigmoid_gate
+                                    )
+                                    tCompute[i] = left * right
+                        elif cutlass.const_expr(self.situ_beta is not None):
                             # Keep the Python float so situ_f32 can fold 1/beta.
                             situ_beta = self.situ_beta
                             if cutlass.const_expr(self.situ_linear_beta is not None):
