+                        * torch.tanh(gate / swiglu_alpha)
+                        * torch.sigmoid(gate)
+                    )
+                elif activation == "situ":
                     situ_gate = (
                         situ_beta * torch.tanh(gate / situ_beta) * torch.sigmoid(gate)
                     )
