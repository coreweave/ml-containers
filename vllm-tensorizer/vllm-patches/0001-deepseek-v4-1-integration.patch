+        if entry == "carried":
+            pre_mix = torch.rand(num_tokens, hc_mult, device=DEVICE)
+            if num_tokens > 1:
+                # A constant collapse just above 1 rounds to BF16 1 before RMSNorm.
+                residual[1].fill_(1)
+                pre_mix[1].zero_()
+                pre_mix[1, 0] = 1.003
