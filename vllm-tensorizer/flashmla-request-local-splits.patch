From 4848e093443caec5cae3b8e9e4329f00d5937182 Mon Sep 17 00:00:00 2001
From: Ace Eldeib <aeldeib@coreweave.com>
Date: Sun, 23 Aug 2026 10:14:43 -0400
Subject: [PATCH] fix(decode): Make sparse split scheduling request-local

Global payload balancing changes a request reduction tree when batch neighbors change, causing batch-dependent BF16 outputs.

Use fixed per-request chunks and independent logical scheduler rows while retaining split-K parallelism and stable graph shapes.

Signed-off-by: Ace Eldeib <aeldeib@coreweave.com>
---
 csrc/api/dense_decode.h                       |   2 +
 csrc/api/sparse_decode.h                      |  53 +++++--
 csrc/params.h                                 |  10 +-
 .../fwd_for_small_topk/head128/phase1.cuh     |   2 +-
 csrc/smxx/decode/combine/combine.cu           |   2 +-
 .../get_decoding_sched_meta.cu                | 143 ++++++++++++++----
 6 files changed, 162 insertions(+), 50 deletions(-)

diff --git a/csrc/api/dense_decode.h b/csrc/api/dense_decode.h
index d52ea8c..1cdc129 100644
--- a/csrc/api/dense_decode.h
+++ b/csrc/api/dense_decode.h
@@ -119,6 +119,8 @@ dense_attn_decode_interface(
             (DecodingSchedMeta*)tile_scheduler_metadata->data_ptr(),
             num_splits->mutable_data_ptr<int>(),
             num_sm_parts,
+            0,
+            0,
             get_current_cuda_stream(q)
         };
         smxx::decode::run_get_decoding_sched_meta_kernel(get_sched_meta_params);
diff --git a/csrc/api/sparse_decode.h b/csrc/api/sparse_decode.h
index d6627cf..a48c3aa 100644
--- a/csrc/api/sparse_decode.h
+++ b/csrc/api/sparse_decode.h
@@ -31,6 +31,7 @@ struct DecodeImplMeta {
     int num_sm_parts;
     int fixed_overhead_num_blocks;
     int block_size_topk;
+    int sparse_split_blocks;
 };

 class DecodeImplBase : public ImplBase<
@@ -61,7 +62,8 @@ public:
         return {
             std::max(arch.num_sms / s_q / (h_q/64), 1),
             5,
-            64
+            64,
+            16
         };
     }

@@ -94,7 +96,8 @@ public:
         return {
             std::max(arch.num_sms / s_q, 1),
             5,
-            64
+            64,
+            8
         };
     }

@@ -128,7 +131,8 @@ public:
         return {
             std::max(arch.num_sms / s_q, 1),
             5,
-            64
+            64,
+            8
         };
     }

@@ -170,7 +174,8 @@ public:
         return {
             std::max(arch.num_sms / s_q / 2, 1),
             3,
-            64
+            64,
+            8
         };
     }

@@ -390,6 +395,27 @@ sparse_attn_decode_interface(
     }

     DecodeImplMeta impl_meta = impl->get_meta(h_q, s_q);
+    // Sparse reduction chunks must depend only on one request's work. Reserve
+    // a fixed per-request capacity so CUDA graph launch shapes remain stable.
+    const auto ceil_div_int = [](int value, int divisor) {
+        return (value + divisor - 1) / divisor;
+    };
+    int max_sparse_tokens = std::max(topk, 1);
+    if (extra_topk > 0) {
+        max_sparse_tokens =
+            ceil_div_int(max_sparse_tokens, impl_meta.block_size_topk)
+            * impl_meta.block_size_topk;
+        max_sparse_tokens += extra_topk;
+    }
+    const int max_blocks_per_request =
+        ceil_div_int(max_sparse_tokens, impl_meta.block_size_topk);
+    const int max_splits_per_request =
+        ceil_div_int(max_blocks_per_request, impl_meta.sparse_split_blocks);
+    STD_TORCH_CHECK(max_splits_per_request > 0 && max_splits_per_request <= 160);
+    STD_TORCH_CHECK(b <= 65535 / max_splits_per_request);
+    const int accum_capacity = b * max_splits_per_request;
+    const int num_sched_parts = accum_capacity;
+    STD_TORCH_CHECK(num_sched_parts > 0 && num_sched_parts <= 65535);

     SparseAttnDecodeParams params = {
         b, s_q, h_q, h_kv, d_qk, d_v,
@@ -426,7 +452,7 @@ sparse_attn_decode_interface(
     // Get MLA metadata if necessary
     Tensor o_accum, lse_accum;
     if (!tile_scheduler_metadata.has_value()) {
-        tile_scheduler_metadata = torch::stable::new_empty(q, {impl_meta.num_sm_parts, sizeof(DecodingSchedMeta)/4}, ScalarType::Int);
+        tile_scheduler_metadata = torch::stable::new_empty(q, {num_sched_parts, sizeof(DecodingSchedMeta)/4}, ScalarType::Int);
         num_splits = torch::stable::new_empty(q, {b+1}, ScalarType::Int);
         KU_CHECK_CONTIGUOUS(tile_scheduler_metadata);
         KU_CHECK_CONTIGUOUS(num_splits);
@@ -442,7 +468,9 @@ sparse_attn_decode_interface(
             nullptr,
             (DecodingSchedMeta*)tile_scheduler_metadata->data_ptr(),
             num_splits->mutable_data_ptr<int>(),
-            impl_meta.num_sm_parts,
+            num_sched_parts,
+            impl_meta.sparse_split_blocks,
+            max_splits_per_request,
             get_current_cuda_stream(q)
         };
         smxx::decode::run_get_decoding_sched_meta_kernel(get_sched_meta_params);
@@ -454,16 +482,17 @@ sparse_attn_decode_interface(
     KU_CHECK_DTYPE(num_splits, ScalarType::Int);
     KU_CHECK_CONTIGUOUS(tile_scheduler_metadata);
     KU_CHECK_CONTIGUOUS(num_splits);
-    KU_CHECK_SHAPE(tile_scheduler_metadata, impl_meta.num_sm_parts, sizeof(DecodingSchedMeta)/sizeof(int));
+    KU_CHECK_SHAPE(tile_scheduler_metadata, num_sched_parts, sizeof(DecodingSchedMeta)/sizeof(int));
     KU_CHECK_SHAPE(num_splits, b+1);
     params.tile_scheduler_metadata_ptr = (DecodingSchedMeta*)tile_scheduler_metadata->data_ptr();
     params.num_splits_ptr = num_splits->mutable_data_ptr<int>();
-    params.num_sm_parts = impl_meta.num_sm_parts;
+    params.num_sm_parts = num_sched_parts;
+    params.max_splits_per_request = max_splits_per_request;
+    params.accum_capacity = accum_capacity;

     // Allocate intermediate buffers for split-KV
-    const int total_num_splits = b + impl_meta.num_sm_parts;
-    lse_accum = torch::stable::new_empty(q, {total_num_splits, s_q, h_q}, ScalarType::Float);
-    o_accum = torch::stable::new_empty(q, {total_num_splits, s_q, h_q, d_v}, ScalarType::Float);
+    lse_accum = torch::stable::new_empty(q, {accum_capacity, s_q, h_q}, ScalarType::Float);
+    o_accum = torch::stable::new_empty(q, {accum_capacity, s_q, h_q, d_v}, ScalarType::Float);
     KU_CHECK_CONTIGUOUS(lse_accum);
     KU_CHECK_CONTIGUOUS(o_accum);
     params.lse_accum = lse_accum.mutable_data_ptr<float>();
@@ -491,7 +520,7 @@ sparse_attn_decode_interface(

         params.tile_scheduler_metadata_ptr,
         params.num_splits_ptr,
-        params.num_sm_parts,
+        params.max_splits_per_request,

         ku::get_optional_tensor_ptr<float>(attn_sink),
         get_current_cuda_stream(q)
diff --git a/csrc/params.h b/csrc/params.h
