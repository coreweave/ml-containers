+def write_bytes_if_different(path: pathlib.Path, content: bytes) -> None:
+    if path.exists():
+        stat = path.stat()
+        if stat.st_size == len(content) and path.read_bytes() == content:
+            return
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(content)
